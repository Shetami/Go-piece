---
import { getCollection } from 'astro:content'
import KafkaStandIsland from './ui/KafkaStand.tsx'
import { kafkaScenarioById } from './engine/scenarios.ts'

/**
 * Стенд в MDX: <KafkaStand scenario="journey" />.
 * Обёртка нужна, чтобы при сборке подтянуть определения терминов в остров
 * и проверить, что такой сценарий существует.
 */
interface Props {
  scenario: string
  mode?: 'embed' | 'lab'
}

const { scenario, mode = 'embed' } = Astro.props
if (!kafkaScenarioById(scenario)) {
  throw new Error(`<KafkaStand scenario="${scenario}">: нет такого сценария в engine/scenarios.ts`)
}

const terms = Object.fromEntries(
  (await getCollection('glossary')).map((e) => [e.id, { title: e.data.title, short: e.data.short }]),
)
---

<div class:list={['not-prose', mode === 'embed' && 'wide']} data-pagefind-ignore>
  <KafkaStandIsland client:visible scenario={scenario} mode={mode} terms={terms} />
</div>
