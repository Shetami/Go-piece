---
/**
 * Проверки Go-сервиса в пулл-реквесте: параллельные задачи на шкале времени,
 * без кэша и с кэшем. Время конвейера — самая длинная полоса, а не сумма.
 */
const scale = 60 // пикселей на минуту
const x0 = 170
const jobs = [
  { t: 'fmt, tidy, vet', cold: 2.2, warm: 0.6 },
  { t: 'golangci-lint', cold: 4.5, warm: 1.2 },
  { t: 'go test -race', cold: 7.5, warm: 3.2 },
  { t: 'интеграционные', cold: 8.5, warm: 5.4 },
  { t: 'govulncheck', cold: 2.5, warm: 0.9 },
  { t: 'сборка образа', cold: 6, warm: 1.8 },
]
const warmMax = Math.max(...jobs.map((j) => j.warm))
const coldMax = Math.max(...jobs.map((j) => j.cold))
const ticks = [0, 2, 4, 6, 8]
const ru = (n: number) => String(n).replace('.', ',')
---

<figure class="dg not-prose">
  <div class="dg-scroll">
    <svg viewBox="0 0 760 330" role="img" aria-labelledby="cigo-t">
      <title id="cigo-t">Шесть проверок Go-сервиса идут параллельно. Без кэша самая долгая занимает около восьми с половиной минут, с кэшем модулей и сборки — около пяти с половиной, и это время всего конвейера</title>
      <text x={x0} y="20" class="t-muted t-small">без кэша</text>
      <rect x={x0 + 70} y="10" width="22" height="12" rx="3" class="cell-pending"></rect>
      <text x={x0 + 110} y="20" class="t-muted t-small">с кэшем</text>
      <rect x={x0 + 170} y="10" width="22" height="12" rx="3" class="cell-on"></rect>

      {jobs.map((j, i) => (
        <g>
          <text x={x0 - 12} y={58 + i * 40} text-anchor="end" class="t-small t-mono">{j.t}</text>
          <rect x={x0} y={42 + i * 40} width={j.cold * scale} height="24" rx="4" class="cell-pending"></rect>
          <rect x={x0} y={46 + i * 40} width={j.warm * scale} height="16" rx="3" class="cell-on"></rect>
        </g>
      ))}

      <path d={`M${x0} 280 H${x0 + 9.2 * scale}`} class="ln-thin"></path>
      {ticks.map((t) => (
        <g>
          <path d={`M${x0 + t * scale} 276 V284`} class="ln-thin"></path>
          <text x={x0 + t * scale} y="298" text-anchor="middle" class="t-muted t-small">{t} мин</text>
        </g>
      ))}

      <path d={`M${x0 + warmMax * scale} 34 V276`} class="ln-accent"></path>
      <text x={x0 + warmMax * scale - 6} y="320" text-anchor="end" class="t-accent t-small">конвейер с кэшем ≈ {ru(warmMax)} мин</text>
      <path d={`M${x0 + coldMax * scale} 34 V276`} class="ln-dash"></path>
      <text x={x0 + coldMax * scale - 4} y="320" text-anchor="end" class="t-muted t-small">без кэша ≈ {ru(coldMax)}</text>
    </svg>
  </div>
  <figcaption>
    Задачи не ждут друг друга, поэтому время конвейера определяет самая длинная — здесь интеграционные тесты. Кэш
    модулей и сборки ускоряет всё, но ускорять имеет смысл прежде всего то, что лежит на критическом пути.
  </figcaption>
</figure>
