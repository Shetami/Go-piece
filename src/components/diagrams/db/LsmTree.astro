---
/**
 * LSM-дерево: запись в память и журнал, сброс неизменяемыми файлами, слияние уровней.
 */
const l0 = [
  { x: 200, label: 'c–x' },
  { x: 290, label: 'a–p' },
  { x: 380, label: 'f–z' },
]
const l1 = [
  { x: 200, w: 110, label: 'a–f' },
  { x: 316, w: 110, label: 'g–m' },
  { x: 432, w: 110, label: 'n–z' },
]
---

<figure class="dg not-prose">
  <div class="dg-scroll">
    <svg viewBox="0 0 760 290" role="img" aria-labelledby="dblsm-t">
      <title id="dblsm-t">LSM-дерево: запись попадает в memtable и журнал, memtable сбрасывается на диск файлом уровня 0, компакция сливает файлы в уровень 1</title>
      <defs>
        <marker id="dblsm-a" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse" markerUnits="userSpaceOnUse">
          <path d="M0,0 L8,4 L0,8 z" class="head"></path>
        </marker>
      </defs>

      <text x="20" y="54" class="t-bold">запись</text>
      <path d="M72 50 H192" class="ln" marker-end="url(#dblsm-a)"></path>

      <text x="200" y="22" class="t-muted t-small">память</text>
      <rect x="200" y="30" width="200" height="40" rx="6" class="lead"></rect>
      <text x="300" y="55" text-anchor="middle">memtable · отсортирована</text>
      <rect x="420" y="30" width="120" height="40" rx="6" class="box-2"></rect>
      <text x="480" y="55" text-anchor="middle">WAL</text>
      <path d="M132 50 C140 90, 440 96, 470 72" class="ln ln-dash" marker-end="url(#dblsm-a)"></path>

      <path d="M300 70 V112" class="ln" marker-end="url(#dblsm-a)"></path>
      <text x="308" y="96" class="t-muted t-small">заполнилась — сброс одним файлом</text>

      <text x="20" y="140" class="t-muted">уровень 0</text>
      {
        l0.map((f) => (
          <g>
            <rect x={f.x} y="118" width="84" height="34" rx="5" class="box"></rect>
            <text x={f.x + 42} y="140" text-anchor="middle" class="t-mono t-small">{f.label}</text>
          </g>
        ))
      }
      <text x="480" y="132" class="t-muted t-small">диапазоны файлов</text>
      <text x="480" y="146" class="t-muted t-small">пересекаются</text>

      <path d="M300 152 V194" class="ln" marker-end="url(#dblsm-a)"></path>
      <text x="308" y="178" class="t-muted t-small">компакция: слить, выбросить старые версии и удалённое</text>

      <text x="20" y="222" class="t-muted">уровень 1</text>
      {
        l1.map((f) => (
          <g>
            <rect x={f.x} y="200" width={f.w} height="34" rx="5" class="box-2"></rect>
            <text x={f.x + f.w / 2} y="222" text-anchor="middle" class="t-mono t-small">{f.label}</text>
          </g>
        ))
      }
      <text x="560" y="214" class="t-muted t-small">не пересекаются,</text>
      <text x="560" y="228" class="t-muted t-small">каждый уровень ×10</text>
      <text x="200" y="262" class="t-muted t-small">…и дальше уровни 2, 3 — всё крупнее</text>

      <text x="600" y="54" class="t-small t-bold">чтение ключа</text>
      <text x="600" y="72" class="t-muted t-small">memtable →</text>
      <text x="600" y="88" class="t-muted t-small">все файлы L0 →</text>
      <text x="600" y="104" class="t-muted t-small">один файл L1 → …</text>
      <text x="600" y="120" class="t-muted t-small">Фильтр Блума у файла</text>
      <text x="600" y="136" class="t-muted t-small">отсекает лишние.</text>
    </svg>
  </div>
  <figcaption>
    LSM-дерево ничего не меняет на диске на месте. Запись — это журнал и отсортированная структура в памяти; заполнившись,
    она ложится на диск одним неизменяемым файлом. Фоновая компакция сливает файлы в более крупные уровни. Запись
    дешёвая и последовательная, а чтению приходится заглядывать в несколько мест.
  </figcaption>
</figure>
