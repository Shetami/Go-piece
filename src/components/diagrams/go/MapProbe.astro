---
/**
 * Последовательность проб по группам: треугольные шаги +1, +2, +3 по модулю числа групп.
 * Полные группы и группы с надгробиями пропускаются, группа с пустым слотом завершает поиск.
 */
const N = 16
const W = 42
const X0 = 28
// h1 & mask = 3 → 3, 4, 6, 9
const seq = [
  { g: 3, kind: 'full', note: 'полная, H2 не совпал' },
  { g: 4, kind: 'tomb', note: 'надгробие — не останавливает' },
  { g: 6, kind: 'full', note: 'полная, кандидат ≠ ключ' },
  { g: 9, kind: 'empty', note: 'есть empty — стоп' },
]
const kindOf = (i: number) => seq.find((s) => s.g === i)?.kind
---

<figure class="dg not-prose">
  <div class="dg-scroll">
    <svg viewBox="0 0 760 250" role="img" aria-labelledby="gmp-t">
      <title id="gmp-t">Поиск идёт по группам 3, 4, 6, 9: шаг растёт на единицу; группа с пустым слотом завершает поиск</title>
      <defs>
        <marker id="gmp-a" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto" markerUnits="userSpaceOnUse">
          <path d="M0,0 L8,4 L0,8 z" class="head-accent"></path>
        </marker>
      </defs>

      <text x="20" y="24" class="t-bold">таблица из 16 групп · offset₀ = H1 &amp; 15 = 3 · offsetᵢ = offsetᵢ₋₁ + i</text>
      {
        Array.from({ length: N }, (_, i) => {
          const k = kindOf(i)
          const cls = k === 'empty' ? 'lead' : k === 'tomb' ? 'cell-pending' : k === 'full' ? 'cell-on' : 'cell'
          return (
            <g>
              <rect x={X0 + i * W} y="120" width={W - 4} height="34" rx="3" class={cls}></rect>
              <text x={X0 + i * W + (W - 4) / 2} y="142" text-anchor="middle" class="t-mono t-small">{i}</text>
            </g>
          )
        })
      }
      {
        seq.slice(0, -1).map((s, i) => {
          const a = X0 + s.g * W + (W - 4) / 2
          const b = X0 + seq[i + 1].g * W + (W - 4) / 2
          const h = 30 + i * 16
          return (
            <g>
              <path d={`M${a} 116 C${a} ${116 - h}, ${b} ${116 - h}, ${b} 118`} class="ln-accent" marker-end="url(#gmp-a)"></path>
              <text x={(a + b) / 2} y={116 - h * 0.75 - 4} text-anchor="middle" class="t-accent t-small">+{i + 1}</text>
            </g>
          )
        })
      }
      {
        seq.map((s, i) => (
          <text x={X0 + s.g * W + (W - 4) / 2} y={174 + (i % 2) * 14} text-anchor="middle" class={s.kind === 'empty' ? 't-ok t-small' : 't-muted t-small'}>{s.note}</text>
        ))
      }
      <text x="20" y="222" class="t-small">p(i) = H1 + i(i+1)/2 mod 16. При числе групп — степени двойки — такая последовательность обходит каждую группу ровно один раз,</text>
      <text x="20" y="240" class="t-small">поэтому поиск всегда завершается: таблица никогда не заполняется до конца, и группа с empty где-то есть.</text>
    </svg>
  </div>
  <figcaption>
    Квадратичные пробы по группам. Вставка идёт по той же последовательности и кладёт ключ в первое свободное место —
    поэтому группа, в которой есть <code>empty</code>, означает «дальше этот ключ не уходил». Надгробие такого права не
    даёт: когда вставляли ключи, группа была полной, и они могли пройти дальше.
  </figcaption>
</figure>
