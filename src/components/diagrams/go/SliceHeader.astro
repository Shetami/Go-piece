---
/**
 * Заголовок слайса и массив под ним: два слайса смотрят в один массив
 * с разными ptr, len и cap.
 */
const X0 = 250
const W = 56
const cells = [10, 20, 30, 40, 50, 0, 0, 0]
// s := make([]int, 5, 8); t := s[1:3]
---

<figure class="dg not-prose">
  <div class="dg-scroll">
    <svg viewBox="0 0 760 270" role="img" aria-labelledby="gsh-t">
      <title id="gsh-t">Слайс — это три слова: указатель на массив, длина и ёмкость. Два слайса могут смотреть в один массив</title>
      <defs>
        <marker id="gsh-a" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto" markerUnits="userSpaceOnUse">
          <path d="M0,0 L8,4 L0,8 z" class="head"></path>
        </marker>
        <marker id="gsh-b" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto" markerUnits="userSpaceOnUse">
          <path d="M0,0 L8,4 L0,8 z" class="head-accent"></path>
        </marker>
      </defs>

      <text x="20" y="30" class="t-bold t-mono">s := make([]int, 5, 8)</text>
      <rect x="20" y="42" width="160" height="72" rx="6" class="box-2"></rect>
      <text x="32" y="64" class="t-mono t-small">ptr</text>
      <text x="32" y="84" class="t-mono t-small">len = 5</text>
      <text x="32" y="104" class="t-mono t-small">cap = 8</text>
      <path d={`M100 60 C160 60, 200 130, ${X0 - 4} 138`} class="ln" marker-end="url(#gsh-a)"></path>

      <text x={X0} y="118" class="t-muted t-small">массив [8]int в куче</text>
      {
        cells.map((v, i) => (
          <g>
            <rect x={X0 + i * W} y="126" width={W} height="34" class={i < 5 ? 'cell-on' : 'cell-pending'}></rect>
            <text x={X0 + i * W + W / 2} y="148" text-anchor="middle" class="t-mono">{v}</text>
            <text x={X0 + i * W + W / 2} y="176" text-anchor="middle" class="t-muted t-small">{i}</text>
          </g>
        ))
      }
      <path d={`M${X0} 186 H${X0 + 5 * W}`} class="ln-accent"></path>
      <text x={X0 + (5 * W) / 2} y="200" text-anchor="middle" class="t-accent t-small">len(s) — видно через s[i]</text>
      <path d={`M${X0} 212 H${X0 + 8 * W}`} class="ln"></path>
      <text x={X0 + 4 * W} y="226" text-anchor="middle" class="t-muted t-small">cap(s) — куда append может писать без новой аллокации</text>

      <text x="20" y="158" class="t-bold t-mono">t := s[1:3]</text>
      <rect x="20" y="170" width="160" height="72" rx="6" class="box"></rect>
      <text x="32" y="192" class="t-mono t-small">ptr = &amp;arr[1]</text>
      <text x="32" y="212" class="t-mono t-small">len = 2</text>
      <text x="32" y="232" class="t-mono t-small">cap = 7</text>
      <path d={`M150 188 C200 188, ${X0 + W + 10} 60, ${X0 + W + W / 2} 122`} class="ln-accent" marker-end="url(#gsh-b)"></path>

      <text x="20" y="262" class="t-muted t-small">Скопировать слайс — скопировать эти три слова. Массив остаётся один.</text>
    </svg>
  </div>
  <figcaption>
    Переменная типа <code>[]int</code> — это 24 байта: указатель, длина и ёмкость. Сами элементы лежат в отдельном
    массиве. Срез <code>s[1:3]</code> ничего не копирует: это новый заголовок, который смотрит в тот же массив со
    сдвигом. Ёмкость считается до конца массива, поэтому у <code>t</code> она 7.
  </figcaption>
</figure>
