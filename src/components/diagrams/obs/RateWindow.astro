---
/**
 * Счётчик с перезапуском пода и окно rate(): точки сбора, сброс в ноль
 * и то, как rate склеивает рост до и после сброса.
 */
const values = [100, 112, 121, 135, 146, 160, 8, 20, 31, 45, 57, 70, 82]
const X = (t: number) => 90 + t * 50
const Y = (v: number) => 250 - v * 1.15
const pts = values.map((v, t) => ({ x: X(t), y: Y(v), v }))
const before = pts.slice(0, 6)
const after = pts.slice(6)
const path = (ps: typeof pts) => ps.map((p, i) => `${i ? 'L' : 'M'}${p.x} ${p.y}`).join(' ')
---

<figure class="dg not-prose">
  <div class="dg-scroll">
    <svg viewBox="0 0 760 320" role="img" aria-labelledby="obrw-t">
      <title id="obrw-t">Счётчик растёт от 100 до 160, под перезапускается, счётчик начинается с нуля и дорастает до 82. rate за окно в две минуты видит падение значения, считает его сбросом и складывает рост до и после: скорость остаётся правильной</title>
      <defs>
        <marker id="obrw-a" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse" markerUnits="userSpaceOnUse">
          <path d="M0,0 L8,4 L0,8 z" class="head"></path>
        </marker>
      </defs>

      <path d="M70 256 H720" class="ln-thin"></path>
      <path d="M70 256 V40" class="ln-thin"></path>
      <text x="64" y="44" text-anchor="end" class="t-muted t-small">значение</text>
      <text x="720" y="274" text-anchor="end" class="t-muted t-small">время, точка сбора раз в 15 с</text>

      <rect x={X(4) - 10} y="36" width={X(12) - X(4) + 20} height="214" rx="6" class="cell-on"></rect>
      <text x={X(8)} y="30" text-anchor="middle" class="t-accent t-small">окно rate(…[2m]) — 9 точек</text>

      <path d={path(before)} class="ln"></path>
      <path d={path(after)} class="ln"></path>
      <path d={`M${before[5].x} ${before[5].y} L${after[0].x} ${after[0].y}`} class="ln ln-dash"></path>
      {pts.map((p) => <circle cx={p.x} cy={p.y} r="4" class="dot-ok"></circle>)}
      {pts.map((p) => <text x={p.x} y={p.y - 10} text-anchor="middle" class="t-mono t-small">{p.v}</text>)}

      <path d={`M${X(6)} 60 V256`} class="ln-life"></path>
      <text x={X(6)} y="272" text-anchor="middle" class="t-bad t-small">перезапуск пода</text>

      <text x="90" y="296" class="t-small">rate видит 160 → 8 и считает это сбросом: рост = (160 − 146) + 8 + (82 − 8) = 96 за 2 мин = 0,8/с.</text>
      <text x="90" y="312" class="t-muted t-small">Без учёта сброса вышло бы (82 − 146) / 120 — отрицательная скорость у счётчика, который только рос.</text>
    </svg>
  </div>
  <figcaption>
    rate работает только со счётчиками: любое падение значения он считает перезапуском и прибавляет рост после него.
    Поэтому rate нельзя брать от суммы счётчиков разных подов — там падение одного пода выглядит как сброс всей суммы — и
    от gauge, который уменьшается по делу.
  </figcaption>
</figure>
