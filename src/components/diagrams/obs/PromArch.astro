---
/**
 * Путь метрики внутри Prometheus: обнаружение целей → сбор → head в памяти и WAL →
 * двухчасовые блоки на диске → компакция. Запрос читает и head, и блоки.
 */
const targets = [130, 180, 230]
const blocks = [
  { y: 58, t: 'блок 2 ч' },
  { y: 94, t: 'блок 2 ч' },
  { y: 130, t: 'блок 6 ч (компакция)' },
]
---

<figure class="dg not-prose">
  <div class="dg-scroll">
    <svg viewBox="0 0 760 300" role="img" aria-labelledby="obpa-t">
      <title id="obpa-t">Prometheus узнаёт цели через обнаружение сервисов, сам забирает с них метрики, пишет свежие точки в head-блок в памяти и в WAL на диске, каждые два часа сбрасывает head в неизменяемый блок и потом склеивает блоки компакцией. Запрос читает head и блоки вместе</title>
      <defs>
        <marker id="obpa-a" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse" markerUnits="userSpaceOnUse">
          <path d="M0,0 L8,4 L0,8 z" class="head"></path>
        </marker>
      </defs>

      <rect x="20" y="36" width="160" height="54" rx="8" class="box-2"></rect>
      <text x="100" y="58" text-anchor="middle" class="t-bold">обнаружение</text>
      <text x="100" y="76" text-anchor="middle" class="t-muted t-small">API Kubernetes, Consul…</text>

      {targets.map((y, i) => (
        <g>
          <rect x="20" y={y} width="160" height="38" rx="6" class="box"></rect>
          <text x="100" y={y + 24} text-anchor="middle" class="t-mono t-small">под-{i + 1} :8080/metrics</text>
        </g>
      ))}

      <rect x="230" y="20" width="510" height="262" rx="10" class="note"></rect>
      <text x="246" y="40" class="t-bold">Prometheus</text>

      <rect x="250" y="130" width="140" height="64" rx="8" class="box"></rect>
      <text x="320" y="154" text-anchor="middle" class="t-bold">сбор</text>
      <text x="320" y="172" text-anchor="middle" class="t-muted t-small">раз в 15–30 с,</text>
      <text x="320" y="186" text-anchor="middle" class="t-muted t-small">relabeling</text>

      <path d="M180 63 C215 63, 230 100, 280 128" class="ln ln-dash" marker-end="url(#obpa-a)"></path>
      <text x="196" y="108" class="t-muted t-small">цели</text>
      {targets.map((y) => (
        <path d={`M248 ${162} L184 ${y + 19}`} class="ln-accent" marker-end="url(#obpa-a)"></path>
      ))}
      <text x="250" y="266" class="t-accent t-small">pull: Prometheus ходит сам</text>

      <rect x="420" y="58" width="150" height="72" rx="8" class="box-2"></rect>
      <text x="495" y="82" text-anchor="middle" class="t-bold">head</text>
      <text x="495" y="100" text-anchor="middle" class="t-muted t-small">в памяти: последние</text>
      <text x="495" y="114" text-anchor="middle" class="t-muted t-small">~2–3 ч, все живые ряды</text>

      <rect x="420" y="170" width="150" height="54" rx="8" class="box"></rect>
      <text x="495" y="192" text-anchor="middle" class="t-bold">WAL</text>
      <text x="495" y="210" text-anchor="middle" class="t-muted t-small">переживает рестарт</text>

      <path d="M390 150 L416 110" class="ln" marker-end="url(#obpa-a)"></path>
      <path d="M390 176 L416 192" class="ln" marker-end="url(#obpa-a)"></path>

      {blocks.map((b) => (
        <g>
          <rect x="604" y={b.y} width="124" height="28" rx="5" class="box"></rect>
          <text x="666" y={b.y + 18} text-anchor="middle" class="t-small">{b.t}</text>
        </g>
      ))}
      <path d="M570 84 L600 76" class="ln" marker-end="url(#obpa-a)"></path>
      <text x="576" y="56" class="t-muted t-small">каждые 2 ч</text>
      <text x="604" y="178" class="t-muted t-small">на диске, неизменяемые;</text>
      <text x="604" y="192" class="t-muted t-small">удаляются по retention</text>

      <rect x="420" y="240" width="308" height="32" rx="6" class="box-2"></rect>
      <text x="574" y="261" text-anchor="middle" class="t-small">PromQL: читает head + блоки за нужный интервал</text>
    </svg>
  </div>
  <figcaption>
    Prometheus не ждёт, пока ему пришлют данные: он сам узнаёт список целей и раз в интервал забирает с каждой текущие
    значения. Свежие точки лежат в памяти (head) и дублируются в журнал WAL, старые — в неизменяемых блоках на диске.
    Память Prometheus определяется числом рядов в head, а не объёмом истории.
  </figcaption>
</figure>
