---
/**
 * Путь строки лога: сервис → stdout → файл на узле → агент (DaemonSet) → буфер → хранилище
 * с фазами жизни индекса. Отмечены места, где строка может потеряться.
 */
const stages = [
  { x: 20, w: 110, t: 'сервис', s: 'slog → stdout' },
  { x: 150, w: 120, t: 'файл на узле', s: '/var/log/containers' },
  { x: 290, w: 120, t: 'агент', s: 'Fluent Bit, Vector' },
  { x: 430, w: 110, t: 'буфер', s: 'Kafka' },
  { x: 560, w: 180, t: 'Elasticsearch', s: 'или OpenSearch, Loki' },
]
const phases = [
  { x: 560, w: 60, t: 'hot' },
  { x: 620, w: 44, t: 'warm' },
  { x: 664, w: 40, t: 'cold' },
  { x: 704, w: 36, t: '✕' },
]
const risks = [
  { x: 210, t: 'ротация: 10 МБ × 5', s: 'агент отстал — файл удалён' },
  { x: 350, t: 'буфер агента полон', s: 'хранилище не успевает' },
  { x: 550, t: 'отказ маппинга', s: 'документ отвергнут' },
]
---

<figure class="dg not-prose">
  <div class="dg-scroll">
    <svg viewBox="0 0 760 260" role="img" aria-labelledby="oblp-t">
      <title id="oblp-t">Сервис пишет строку в stdout, среда контейнеров складывает её в файл на узле, агент на каждом узле читает файлы, дополняет метаданными Kubernetes и отправляет через буфер в хранилище. Индексы в хранилище проходят фазы hot, warm, cold и удаляются. Строка может потеряться при ротации файла, при переполнении буфера агента и при отказе маппинга</title>
      <defs>
        <marker id="oblp-a" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse" markerUnits="userSpaceOnUse">
          <path d="M0,0 L8,4 L0,8 z" class="head"></path>
        </marker>
      </defs>

      <rect x="10" y="20" width="410" height="96" rx="10" class="note"></rect>
      <text x="18" y="36" class="t-muted t-small">узел Kubernetes</text>

      {stages.map((s, i) => (
        <g>
          <rect x={s.x} y="46" width={s.w} height="58" rx="8" class={i === 4 ? 'box-2' : 'box'}></rect>
          <text x={s.x + s.w / 2} y="70" text-anchor="middle" class="t-bold">{s.t}</text>
          <text x={s.x + s.w / 2} y="90" text-anchor="middle" class="t-muted t-small">{s.s}</text>
        </g>
      ))}
      {stages.slice(0, -1).map((s, i) => (
        <path d={`M${s.x + s.w + 2} 75 H${stages[i + 1].x - 4}`} class="ln-accent" marker-end="url(#oblp-a)"></path>
      ))}

      {phases.map((p, i) => (
        <g>
          <rect x={p.x} y="112" width={p.w} height="22" rx="3" class={i === 3 ? 'risk' : i === 0 ? 'cell-on' : 'box'}></rect>
          <text x={p.x + p.w / 2} y="127" text-anchor="middle" class="t-small">{p.t}</text>
        </g>
      ))}
      <text x="560" y="150" class="t-muted t-small">фазы жизни индекса (ILM)</text>

      {risks.map((r, i) => (
        <g>
          <path d={`M${r.x} 108 V${170 + (i % 2) * 34}`} class="ln-life"></path>
          <circle cx={r.x} cy={176 + (i % 2) * 34} r="5" class="dot-bad"></circle>
          <text x={r.x} y={198 + (i % 2) * 34} text-anchor="middle" class="t-bad t-small">{r.t}</text>
          <text x={r.x} y={214 + (i % 2) * 34} text-anchor="middle" class="t-muted t-small">{r.s}</text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    Сервис ничего не знает о хранилище логов: он пишет в stdout, а доставкой занимается агент на узле. Это развязывает
    сервис и хранилище, но у цепочки три места, где строки теряются молча, — и все три срабатывают именно во время
    аварии, когда логов больше всего.
  </figcaption>
</figure>
