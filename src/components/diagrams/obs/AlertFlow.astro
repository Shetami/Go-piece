---
/**
 * Путь алерта: правило → pending → firing → Alertmanager → получатели,
 * и шкала времени: for, group_wait, group_interval, repeat_interval.
 */
const stages = [
  { x: 20, w: 160, t: 'правило', s: 'вычисляется раз в 30–60 с' },
  { x: 205, w: 160, t: 'pending → firing', s: 'условие держится for' },
  { x: 390, w: 175, t: 'Alertmanager', s: 'группы, подавление, тишина' },
  { x: 590, w: 150, t: 'получатели', s: 'пейджер, чат, тикет' },
]
const bars = [
  { x0: 60, x1: 250, cls: 'cell-pending', t: 'pending: for 5m', s: 'сорвалось — отсчёт заново' },
  { x0: 250, x1: 320, cls: 'cell-on', t: 'group_wait 30s', s: 'ждём соседей по группе' },
  { x0: 320, x1: 500, cls: 'cell-on', t: 'group_interval 5m', s: 'новые алерты группы — одним письмом' },
  { x0: 500, x1: 740, cls: 'note', t: 'repeat_interval 4h', s: 'напоминание, если не починили' },
]
const sends = [320, 500]
---

<figure class="dg not-prose">
  <div class="dg-scroll">
    <svg viewBox="0 0 760 300" role="img" aria-labelledby="obaf-t">
      <title id="obaf-t">Правило алерта вычисляется по расписанию. Условие должно продержаться время for, и только тогда алерт переходит в firing и уходит в Alertmanager. Тот ждёт group_wait, собирая похожие алерты в одно уведомление, новые алерты той же группы шлёт не чаще group_interval, а нерешённое напоминает раз в repeat_interval</title>
      <defs>
        <marker id="obaf-a" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse" markerUnits="userSpaceOnUse">
          <path d="M0,0 L8,4 L0,8 z" class="head"></path>
        </marker>
      </defs>

      {stages.map((s, i) => (
        <g>
          <rect x={s.x} y="24" width={s.w} height="58" rx="8" class={i === 2 ? 'box-2' : 'box'}></rect>
          <text x={s.x + s.w / 2} y="48" text-anchor="middle" class="t-bold">{s.t}</text>
          <text x={s.x + s.w / 2} y="68" text-anchor="middle" class="t-muted t-small">{s.s}</text>
        </g>
      ))}
      {stages.slice(0, -1).map((s, i) => (
        <path d={`M${s.x + s.w + 2} 53 H${stages[i + 1].x - 4}`} class="ln" marker-end="url(#obaf-a)"></path>
      ))}
      <text x="205" y="104" class="t-muted t-small">Prometheus</text>
      <text x="390" y="104" class="t-muted t-small">отдельный сервис, обычно 2–3 реплики</text>

      <path d="M40 176 H744" class="ln-thin" marker-end="url(#obaf-a)"></path>
      <text x="744" y="196" text-anchor="end" class="t-muted t-small">время</text>
      <path d="M60 140 V184" class="ln-life"></path>
      <text x="60" y="134" class="t-small">условие стало истинным</text>

      {bars.map((b, i) => (
        <g>
          <rect x={b.x0} y="164" width={b.x1 - b.x0} height="24" rx="4" class={b.cls}></rect>
          <text x={b.x0 + 6} y={i % 2 ? 250 : 216} class="t-small">{b.t}</text>
          <text x={b.x0 + 6} y={i % 2 ? 266 : 232} class="t-muted t-small">{b.s}</text>
        </g>
      ))}
      {sends.map((x) => (
        <g>
          <circle cx={x} cy="176" r="6" class="dot-bad"></circle>
          <text x={x} y="154" text-anchor="middle" class="t-bad t-small">уведомление</text>
        </g>
      ))}
    </svg>
  </div>
  <figcaption>
    Между моментом, когда условие стало истинным, и сообщением дежурному проходит for плюс group_wait плюс интервал
    вычисления правила. Это цена того, чтобы не будить людей на секундные всплески и не присылать сто сообщений на
    одну аварию.
  </figcaption>
</figure>
