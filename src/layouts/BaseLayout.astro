---
import '../styles/global.css'
import { SITE } from '../data/site.ts'

interface Props {
  title: string
  description?: string
  /** Широкая страница (лаборатория) — без ограничения ширины колонки. */
  wide?: boolean
  /** Почти во всю ширину экрана — страница задачи: длинным строкам кода нужно место. */
  full?: boolean
}

const { title, description = SITE.tagline, wide = false, full = false } = Astro.props
const fullTitle = title === SITE.name ? title : `${title} — ${SITE.name}`
const path = Astro.url.pathname

const nav = [
  { href: '/lectures/', label: 'Лекции' },
  { href: '/glossary/', label: 'Справочник' },
  { href: '/lab/', label: 'Лаборатория' },
  { href: '/practice/', label: 'Практика' },
  { href: '/quiz/', label: 'Тесты' },
  { href: '/achievements/', label: 'Достижения' },
  { href: '/search/', label: 'Поиск' },
]
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      ;(() => {
        let t = null
        try {
          t = localStorage.getItem('theme')
        } catch {}
        const dark = t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.classList.toggle('dark', dark)
      })()
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-line bg-bg/90 backdrop-blur sticky top-0 z-40">
      <div class="mx-auto max-w-6xl px-4 h-14 flex items-center gap-6">
        <a href="/" class="font-bold tracking-tight text-ink no-underline flex items-center gap-2 shrink-0 whitespace-nowrap">
          <img src="/logo.png" alt="" width="28" height="28" class="size-7 shrink-0" />
          {SITE.name}
        </a>
        <nav class="flex gap-1 text-sm overflow-x-auto">
          {
            nav.map((n) => (
              <a
                href={n.href}
                class:list={[
                  'px-2.5 py-1.5 rounded-md no-underline whitespace-nowrap',
                  path.startsWith(n.href) ? 'text-ink bg-surface-2' : 'text-muted hover:text-ink',
                ]}
              >
                {n.label}
              </a>
            ))
          }
        </nav>
        <div class="ml-auto flex items-center gap-1 shrink-0">
          <div id="account" class="flex items-center gap-1 text-sm" data-state="guest">
            <a href="/login/" class="btn-ghost account-guest">Войти</a>
            <span class="account-user items-center gap-1">
              <span id="account-email" class="text-muted max-w-48 truncate hidden sm:inline"></span>
              <button id="account-logout" type="button" class="btn-ghost">Выйти</button>
            </span>
          </div>
          <script is:inline>
            // Сразу показать, кто вошёл, — до загрузки модулей, чтобы шапка не мигала «Войти».
            ;(() => {
              try {
                const a = JSON.parse(localStorage.getItem('go-piece:owner') || 'null')
                if (!a) return
                document.getElementById('account').dataset.state = 'user'
                document.getElementById('account-email').textContent = a.email
              } catch {}
            })()
          </script>
          <button
            id="theme-toggle"
            type="button"
            class="btn-ghost"
            aria-label="Переключить тему"
            title="Светлая / тёмная тема"
          >
            <span class="dark:hidden">☾</span><span class="hidden dark:inline">☀</span>
          </button>
        </div>
      </div>
    </header>

    <main class:list={['flex-1 w-full mx-auto px-4 py-10', full ? 'max-w-[120rem]' : wide ? 'max-w-7xl' : 'max-w-6xl']}>
      <slot />
    </main>

    <footer class="border-t border-line text-sm text-muted">
      <div class="mx-auto max-w-6xl px-4 py-6 flex flex-wrap gap-x-6 gap-y-2 justify-between">
        <span>{SITE.name} — стенды это модели, а не эмуляторы: где они упрощают, это сказано явно.</span>
        <a href="https://github.com/golang/go/tree/master/src/runtime" class="text-muted hover:text-ink">
          исходники рантайма Go
        </a>
      </div>
    </footer>

    <script>
      import '../components/achievements/tracker.ts'
      import { ACCOUNT_EVENT, cachedAccount, logout, startSync } from '../lib/account.ts'

      const account = document.getElementById('account')
      const showAccount = () => {
        const a = cachedAccount()
        if (!account) return
        account.dataset.state = a ? 'user' : 'guest'
        const email = document.getElementById('account-email')
        if (email) email.textContent = a?.email ?? ''
      }
      window.addEventListener(ACCOUNT_EVENT, showAccount)
      showAccount()
      document.getElementById('account-logout')?.addEventListener('click', async () => {
        await logout()
        location.href = '/'
      })
      startSync()

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark')
        try {
          localStorage.setItem('theme', dark ? 'dark' : 'light')
        } catch {}
      })
    </script>
  </body>
</html>
