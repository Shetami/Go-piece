---
import { getCollection, getEntries, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { termIdsIn } from '../../lib/terms.ts'

export async function getStaticPaths() {
  const terms = await getCollection('glossary')
  return terms.map((entry) => ({ params: { id: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const related = await getEntries(entry.data.related)

const lectures = (await getCollection('lectures', (e) => !e.data.draft)).filter((l) =>
  termIdsIn(l.body).includes(entry.id),
)
const mentionedBy = (await getCollection('glossary')).filter(
  (t) => t.id !== entry.id && t.data.related.some((r) => r.id === entry.id) && !related.some((r) => r.id === t.id),
)
---

<BaseLayout title={entry.data.title} description={entry.data.short}>
  <div class="max-w-3xl">
    <nav class="text-sm text-muted mb-4">
      <a href="/glossary/" class="hover:text-ink">Справочник</a> / {entry.data.category}
    </nav>
    <article data-pagefind-body>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-2">{entry.data.title}</h1>
      {
        entry.data.aliases.length > 0 && (
          <p class="text-sm text-muted mb-4">Также: {entry.data.aliases.join(', ')}</p>
        )
      }
      <p class="text-lg border-l-4 border-accent pl-4 my-6">{entry.data.short}</p>
      <div class="prose dark:prose-invert">
        <Content />
      </div>
      {
        entry.data.source && (
          <p class="mt-6 text-sm text-muted">
            В исходниках: <code class="font-mono text-ink">{entry.data.source}</code>
          </p>
        )
      }
    </article>

    <div class="mt-12 grid sm:grid-cols-2 gap-8 border-t border-line pt-8">
      {
        lectures.length > 0 && (
          <section>
            <h2 class="text-sm uppercase tracking-wider text-muted font-semibold mb-3">Где встречается</h2>
            <ul class="space-y-2">
              {lectures.map((l) => (
                <li>
                  <a href={`/lectures/${l.id}/`} class="text-accent font-medium">
                    {l.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      {
        related.length + mentionedBy.length > 0 && (
          <section>
            <h2 class="text-sm uppercase tracking-wider text-muted font-semibold mb-3">Связанные термины</h2>
            <ul class="space-y-2">
              {[...related, ...mentionedBy].map((t) => (
                <li>
                  <a href={`/glossary/${t.id}/`} class="text-accent font-medium">
                    {t.data.title}
                  </a>
                  <span class="block text-sm text-muted">{t.data.short}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </div>
</BaseLayout>
