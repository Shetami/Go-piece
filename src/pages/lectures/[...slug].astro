---
import { getCollection, render } from 'astro:content'
import LectureLayout from '../../layouts/LectureLayout.astro'
import Term from '../../components/content/Term.astro'
import Callout from '../../components/content/Callout.astro'
import Predict from '../../components/content/Predict.astro'
import GmpStand from '../../components/stands/gmp/GmpStand.astro'
import GcStand from '../../components/stands/gc/GcStand.astro'
import MemStand from '../../components/stands/mem/MemStand.astro'
import ChanStand from '../../components/stands/chan/ChanStand.astro'
import KafkaStand from '../../components/stands/kafka/KafkaStand.astro'
import TxnStand from '../../components/stands/txn/TxnStand.astro'
import ReplStand from '../../components/stands/repl/ReplStand.astro'
import LoadStand from '../../components/stands/load/LoadStand.astro'
import LbStand from '../../components/stands/lb/LbStand.astro'
import CacheStand from '../../components/stands/cache/CacheStand.astro'
import ShardStand from '../../components/stands/shard/ShardStand.astro'
import ResilStand from '../../components/stands/resil/ResilStand.astro'
import SagaStand from '../../components/stands/saga/SagaStand.astro'

export async function getStaticPaths() {
  const lectures = await getCollection('lectures', (e) => !e.data.draft)
  return lectures.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)

const components = { Term, Callout, Predict, GmpStand, GcStand, MemStand, ChanStand, KafkaStand, TxnStand, ReplStand, LoadStand, LbStand, CacheStand, ShardStand, ResilStand, SagaStand }
---

<LectureLayout entry={entry} headings={headings}>
  <Content components={components} />
</LectureLayout>
