---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { SCENARIOS } from '../../components/stands/gmp/engine/scenarios.ts'
import { GC_SCENARIOS } from '../../components/stands/gc/engine/scenarios.ts'
import { MEM_SCENARIOS } from '../../components/stands/mem/engine/scenarios.ts'
import { CHAN_SCENARIOS } from '../../components/stands/chan/engine/scenarios.ts'
import { KAFKA_SCENARIOS } from '../../components/stands/kafka/engine/scenarios.ts'
import { TXN_SCENARIOS } from '../../components/stands/txn/engine/scenarios.ts'
import { REPL_SCENARIOS } from '../../components/stands/repl/engine/scenarios.ts'
import { LOAD_SCENARIOS } from '../../components/stands/load/engine/scenarios.ts'
import { LB_SCENARIOS } from '../../components/stands/lb/engine/scenarios.ts'
import { CACHE_SCENARIOS } from '../../components/stands/cache/engine/scenarios.ts'
import { SHARD_SCENARIOS } from '../../components/stands/shard/engine/scenarios.ts'
import { RESIL_SCENARIOS } from '../../components/stands/resil/engine/scenarios.ts'
import { SAGA_SCENARIOS } from '../../components/stands/saga/engine/scenarios.ts'
---

<BaseLayout title="Лаборатория" description="Интерактивные стенды без лекции: выберите сценарий и крутите настройки.">
  <h1 class="text-3xl font-bold tracking-tight mb-2">Лаборатория</h1>
  <p class="text-muted mb-10 max-w-2xl">
    Стенды отдельно от лекций. Здесь можно менять не только настройки, но и саму нагрузку, а ссылка в адресной
    строке всегда воспроизводит ровно тот прогон, который вы видите.
  </p>

  <div class="grid gap-6 max-w-3xl">
  <a href="/lab/gmp/" class="block rounded-xl border border-line bg-surface p-6 hover:border-muted">
    <span class="text-xs font-semibold text-accent">Рантайм Go</span>
    <span class="block text-xl font-semibold mt-1 mb-2 text-ink">Планировщик: G, M, P</span>
    <span class="block text-muted mb-4">
      Очереди, кража работы, вытеснение, системные вызовы, netpoller и runnext. Готовые сценарии:
    </span>
    <ul class="text-sm text-muted list-disc pl-5 space-y-1">
      {SCENARIOS.map((s) => <li><b class="text-ink font-medium">{s.title}</b> — {s.claim}</li>)}
    </ul>
  </a>

  <a href="/lab/gc/" class="block rounded-xl border border-line bg-surface p-6 hover:border-muted">
    <span class="text-xs font-semibold text-accent">Рантайм Go</span>
    <span class="block text-xl font-semibold mt-1 mb-2 text-ink">Сборщик мусора: разметка на ходу</span>
    <span class="block text-muted mb-4">
      Трёхцветная разметка, барьер записи (его можно выключить и посмотреть, что будет), помощь в разметке,
      пейсер, GOGC и GOMEMLIMIT. Готовые сценарии:
    </span>
    <ul class="text-sm text-muted list-disc pl-5 space-y-1">
      {GC_SCENARIOS.map((s) => <li><b class="text-ink font-medium">{s.title}</b> — {s.claim}</li>)}
    </ul>
  </a>

  <a href="/lab/mem/" class="block rounded-xl border border-line bg-surface p-6 hover:border-muted">
    <span class="text-xs font-semibold text-accent">Рантайм Go</span>
    <span class="block text-xl font-semibold mt-1 mb-2 text-ink">Память: стек, куча и аллокатор</span>
    <span class="block text-muted mb-4">
      Классы размеров, кэш процессора, общий список спанов, большие объекты, рост стека горутины и возврат
      памяти операционной системе. Готовые сценарии:
    </span>
    <ul class="text-sm text-muted list-disc pl-5 space-y-1">
      {MEM_SCENARIOS.map((s) => <li><b class="text-ink font-medium">{s.title}</b> — {s.claim}</li>)}
    </ul>
  </a>

  <a href="/lab/chan/" class="block rounded-xl border border-line bg-surface p-6 hover:border-muted">
    <span class="text-xs font-semibold text-accent">Рантайм Go</span>
    <span class="block text-xl font-semibold mt-1 mb-2 text-ink">Каналы: hchan изнутри</span>
    <span class="block text-muted mb-4">
      Кольцевой буфер, очереди sendq и recvq, передача из рук в руки, select сразу на нескольких каналах,
      закрытие, взаимная блокировка и утечка горутин. Готовые сценарии:
    </span>
    <ul class="text-sm text-muted list-disc pl-5 space-y-1">
      {CHAN_SCENARIOS.map((s) => <li><b class="text-ink font-medium">{s.title}</b> — {s.claim}</li>)}
    </ul>
  </a>

  <a href="/lab/kafka/" class="block rounded-xl border border-line bg-surface p-6 hover:border-muted">
    <span class="text-xs font-semibold text-accent">Брокеры сообщений</span>
    <span class="block text-xl font-semibold mt-1 mb-2 text-ink">Kafka: путь сообщения</span>
    <span class="block text-muted mb-4">
      Продюсер с пакетами, лидер и фолловеры, ISR и high watermark, группы потребителей и коммит оффсетов.
      Любое сообщение можно выбрать и пройти его путь по шагам; брокеры и потребители ломаются по расписанию.
      Готовые сценарии:
    </span>
    <ul class="text-sm text-muted list-disc pl-5 space-y-1">
      {KAFKA_SCENARIOS.map((s) => <li><b class="text-ink font-medium">{s.title}</b> — {s.claim}</li>)}
    </ul>
  </a>

  <a href="/lab/txn/" class="block rounded-xl border border-line bg-surface p-6 hover:border-muted">
    <span class="text-xs font-semibold text-accent">Базы данных</span>
    <span class="block text-xl font-semibold mt-1 mb-2 text-ink">Транзакции: MVCC изнутри</span>
    <span class="block text-muted mb-4">
      Версии строк с xmin и xmax, снимки и уровни изоляции, аномалии, блокировки строк и дедлоки, SSI, VACUUM и
      горизонт очистки, WAL, групповой коммит и падение сервера — по правилам PostgreSQL. Готовые сценарии:
    </span>
    <ul class="text-sm text-muted list-disc pl-5 space-y-1">
      {TXN_SCENARIOS.map((s) => <li><b class="text-ink font-medium">{s.title}</b> — {s.claim}</li>)}
    </ul>
  </a>

  <a href="/lab/repl/" class="block rounded-xl border border-line bg-surface p-6 hover:border-muted">
    <span class="text-xs font-semibold text-accent">Базы данных</span>
    <span class="block text-xl font-semibold mt-1 mb-2 text-ink">Репликация: ведущий и реплики</span>
    <span class="block text-muted mb-4">
      Поток WAL и отставание, синхронные реплики, чтение с реплик, падение ведущего и переключение, слоты
      репликации, конфликты запросов на реплике с вакуумом. Готовые сценарии:
    </span>
    <ul class="text-sm text-muted list-disc pl-5 space-y-1">
      {REPL_SCENARIOS.map((s) => <li><b class="text-ink font-medium">{s.title}</b> — {s.claim}</li>)}
    </ul>
  </a>

  <a href="/lab/load/" class="block rounded-xl border border-line bg-surface p-6 hover:border-muted">
    <span class="text-xs font-semibold text-accent">System design</span>
    <span class="block text-xl font-semibold mt-1 mb-2 text-ink">Нагрузка: очередь, задержка, перегрузка</span>
    <span class="block text-muted mb-4">
      Пул воркеров и очередь перед ним, случайный поток запросов, медленные запросы, всплески, таймауты и повторы,
      отмена по context и предел очереди. Графики очереди, перцентилей задержки и полезных ответов. Готовые сценарии:
    </span>
    <ul class="text-sm text-muted list-disc pl-5 space-y-1">
      {LOAD_SCENARIOS.map((s) => <li><b class="text-ink font-medium">{s.title}</b> — {s.claim}</li>)}
    </ul>
  </a>
  <a href="/lab/lb/" class="block rounded-xl border border-line bg-surface p-6 hover:border-muted">
    <span class="text-xs font-semibold text-accent">System design</span>
    <span class="block text-xl font-semibold mt-1 mb-2 text-ink">Балансировка: реплики и их поломки</span>
    <span class="block text-muted mb-4">
      Балансировщик перед репликами: четыре алгоритма, медленные, сломанные и зависшие реплики, проверки здоровья,
      исключение по ошибкам, повторы на другой реплике и автомасштабирование. Готовые сценарии:
    </span>
    <ul class="text-sm text-muted list-disc pl-5 space-y-1">
      {LB_SCENARIOS.map((s) => <li><b class="text-ink font-medium">{s.title}</b> — {s.claim}</li>)}
    </ul>
  </a>
  <a href="/lab/cache/" class="block rounded-xl border border-line bg-surface p-6 hover:border-muted">
    <span class="text-xs font-semibold text-accent">System design</span>
    <span class="block text-xl font-semibold mt-1 mb-2 text-ink">Кэш: попадания, промахи и лавины</span>
    <span class="block text-muted mb-4">
      Кэш перед базой: неравномерная популярность ключей, вытеснение и TTL, лавина промахов на горячем ключе,
      объединение одинаковых запросов, отдача просроченного значения, инвалидация и холодный старт. Готовые сценарии:
    </span>
    <ul class="text-sm text-muted list-disc pl-5 space-y-1">
      {CACHE_SCENARIOS.map((s) => <li><b class="text-ink font-medium">{s.title}</b> — {s.claim}</li>)}
    </ul>
  </a>
  <a href="/lab/shard/" class="block rounded-xl border border-line bg-surface p-6 hover:border-muted">
    <span class="text-xs font-semibold text-accent">System design</span>
    <span class="block text-xl font-semibold mt-1 mb-2 text-ink">Шарды: раскладка, переезд, перекос</span>
    <span class="block text-muted mb-4">
      Три схемы раскладки ключей, добавление шарда с переездом данных на ходу, горячий ключ, который нельзя
      разделить, и запросы без ключа шардирования, уходящие во все шарды сразу. Готовые сценарии:
    </span>
    <ul class="text-sm text-muted list-disc pl-5 space-y-1">
      {SHARD_SCENARIOS.map((s) => <li><b class="text-ink font-medium">{s.title}</b> — {s.claim}</li>)}
    </ul>
  </a>
  <a href="/lab/resil/" class="block rounded-xl border border-line bg-surface p-6 hover:border-muted">
    <span class="text-xs font-semibold text-accent">System design</span>
    <span class="block text-xl font-semibold mt-1 mb-2 text-ink">Устойчивость: когда зависимость подвела</span>
    <span class="block text-muted mb-4">
      Сервис, который зовёт другой сервис: каскад через занятые воркеры, таймауты и повторы, предохранитель,
      переборки, ограничитель частоты и ответы-заглушки вместо ошибок. Готовые сценарии:
    </span>
    <ul class="text-sm text-muted list-disc pl-5 space-y-1">
      {RESIL_SCENARIOS.map((s) => <li><b class="text-ink font-medium">{s.title}</b> — {s.claim}</li>)}
    </ul>
  </a>
  <a href="/lab/saga/" class="block rounded-xl border border-line bg-surface p-6 hover:border-muted">
    <span class="text-xs font-semibold text-accent">System design</span>
    <span class="block text-xl font-semibold mt-1 mb-2 text-ink">Согласованность: события, дубли и компенсации</span>
    <span class="block text-muted mb-4">
      Заказы, платежи и доставка обмениваются событиями: две записи подряд против transactional outbox, потеря
      событий, дубли доставки и двойные списания, ключ идемпотентности и сага с компенсацией. Готовые сценарии:
    </span>
    <ul class="text-sm text-muted list-disc pl-5 space-y-1">
      {SAGA_SCENARIOS.map((s) => <li><b class="text-ink font-medium">{s.title}</b> — {s.claim}</li>)}
    </ul>
  </a>
  </div>
</BaseLayout>
