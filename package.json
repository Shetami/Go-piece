{
  "name": "go-piece",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site .vercel/output/static",
    "build:node": "DEPLOY_TARGET=node astro build && pagefind --site dist/client",
    "preview": "node scripts/preview.mjs",
    "check": "astro check",
    "test": "node --test \"src/**/*.test.ts\"",
    "demo": "node src/components/stands/gmp/engine/demo.ts",
    "demo:gc": "node src/components/stands/gc/engine/demo.ts",
    "demo:mem": "node src/components/stands/mem/engine/demo.ts",
    "demo:chan": "node src/components/stands/chan/engine/demo.ts",
    "demo:kafka": "node src/components/stands/kafka/engine/demo.ts",
    "demo:txn": "node src/components/stands/txn/engine/demo.ts",
    "demo:repl": "node src/components/stands/repl/engine/demo.ts",
    "demo:load": "node src/components/stands/load/engine/demo.ts",
    "demo:lb": "node src/components/stands/lb/engine/demo.ts",
    "demo:cache": "node src/components/stands/cache/engine/demo.ts",
    "demo:shard": "node src/components/stands/shard/engine/demo.ts",
    "demo:resil": "node src/components/stands/resil/engine/demo.ts",
    "demo:saga": "node src/components/stands/saga/engine/demo.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^6.0.6",
    "@astrojs/vercel": "^11.0.11",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "codemirror": "^6.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.0"
